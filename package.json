{
  "name": "youtubbot-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=@youtubbot/backend\" \"npm run dev --workspace=web\"",
    "build": "npm run build --workspace=web",
    "postinstall": "prisma generate --schema=packages/database/prisma/schema.prisma",
    "start": "npm run start --workspaces",
    "db:start": "node scripts/local_db.js start",
    "db:start:safe": "node scripts/local_db.js start --skip-env-sync",
    "db:stop": "node scripts/local_db.js stop",
    "db:status": "node scripts/local_db.js status",
    "login:youtube": "login_youtube.bat",
    "uploader": "npm run start --workspace=@youtubbot/uploader-agent",
    "worker": "node --import ./scripts/register_hook.mjs scripts/local_worker.mjs",
    "worker:once": "node --import ./scripts/register_hook.mjs scripts/local_worker.mjs --once",
    "test:security": "node tests/security/auth_verification.test.js",
    "test:pipeline": "node --import ./scripts/register_hook.mjs tests/pipeline/pipeline_e2e.test.js",
    "test:workflow": "node --import ./scripts/register_hook.mjs tests/pipeline/phase4a_workflow.test.mjs",
    "test:remediation": "node --import ./scripts/register_hook.mjs tests/security/remediation_regression.test.mjs",
    "test:phase4b": "node --import ./scripts/register_hook.mjs tests/pipeline/phase4b_content_grounding.test.mjs",
    "test:grounding": "node --import ./scripts/register_hook.mjs tests/pipeline/source_grounding_integrity.test.mjs",
    "test:legacy": "node --import ./scripts/register_hook.mjs tests/security/legacy_scraper_isolation.test.mjs",
    "test:tts": "node --import ./scripts/register_hook.mjs tests/security/cross_platform_tts.test.mjs",
    "test:provenance": "node --import ./scripts/register_hook.mjs tests/pipeline/provenance_and_affiliate_integrity.test.mjs",
    "test:align": "node --import ./scripts/register_hook.mjs tests/security/acoustic_alignment.test.mjs",
    "test:creative-e2e": "node --import ./scripts/register_hook.mjs tests/pipeline/creative_core_e2e.test.mjs",
    "test:editorial": "node --import ./scripts/register_hook.mjs tests/pipeline/autonomous_editorial_director.test.mjs",
    "test:footage": "node --import ./scripts/register_hook.mjs tests/pipeline/footage_first_editorial.test.mjs",
    "test": "npm run test:security && npm run test:remediation && npm run test:legacy && npm run test:tts && npm run test:align && npm run test:grounding && npm run test:pipeline && npm run test:workflow && npm run test:phase4b && npm run test:provenance && npm run test:editorial && npm run test:footage",
    "test:dashboard": "node --import ./scripts/register_hook.mjs tests/pipeline/operator_dashboard_cinematic.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "embedded-postgres": "^18.4.0-beta.17"
  },
  "dependencies": {
    "pg": "^8.22.0"
  },
  "overrides": {
    "shell-quote": "^1.12.0",
    "proxy-addr": "^2.0.8",
    "qs": "6.16.1",
    "express": {
      "proxy-addr": "^2.0.8",
      "qs": "6.16.1",
      "body-parser": "^1.20.8"
    },
    "body-parser": {
      "qs": "6.16.1"
    },
    "socks": {
      "ip-address": "^10.7.4"
    },
    "ip-address": "^10.7.4",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.20",
    "source-map-js": "^1.2.2",
    "sharp": "^0.35.5",
    "postcss": "^8.5.30",
    "browserslist": "^4.29.3",
    "baseline-browser-mapping": "^2.11.29"
  }
}
