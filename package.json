{
  "name": "youtubbot-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=@youtubbot/backend\" \"npm run dev --workspace=web\"",
    "build": "npm run build --workspace=web",
    "postinstall": "prisma generate --schema=packages/database/prisma/schema.prisma",
    "start": "npm run start --workspaces",
    "login:youtube": "login_youtube.bat",
    "uploader": "npm run start --workspace=@youtubbot/uploader-agent"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  },
  "dependencies": {
    "pg": "^8.22.0"
  }
}
